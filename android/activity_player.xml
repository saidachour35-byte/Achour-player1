<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- TextureView Surface Type prevents black screen rendering issues on Fire TV & Android TV -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:use_controller="true"
        app:use_artwork="false"
        app:default_artwork="@null"
        app:shutter_background_color="#000000"
        app:surface_type="texture_view"
        app:show_buffering="always"
        app:resize_mode="fit" />

    <!-- Custom Overlay Header -->
    <LinearLayout
        android:id="@+id/player_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#A6000000"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_player_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            app:tint="#D4AF37" />

        <ImageView
            android:id="@+id/player_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Achour Player"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/player_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#D4AF37"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="4K"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_player_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#D4AF37"
            android:contentDescription="Previous Channel" />

        <ImageButton
            android:id="@+id/btn_player_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            app:tint="#D4AF37"
            android:contentDescription="Next Channel" />

        <ImageButton
            android:id="@+id/btn_player_favorite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/btn_star_big_off"
            app:tint="#D4AF37"
            android:contentDescription="Favorite" />

        <ImageButton
            android:id="@+id/btn_player_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="#FFFFFF"
            android:contentDescription="Settings" />

    </LinearLayout>

    <!-- Bottom Satellite OSD Infobar -->
    <LinearLayout
        android:id="@+id/player_infobar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#D9000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/infobar_ch_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#33D4AF37"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="CH 001"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/infobar_ch_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Channel Title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIG 98%  QUAL 95%"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/infobar_now_program"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="NOW: Live Broadcast - HD Stream"
            android:textColor="#D4AF37"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>
